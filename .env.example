# Copy with make setup; a unique local database password is generated.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-long-random-local-password
NEO4J_DATABASE=neo4j
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
AUTO_SEED=true
QUERY_TIMEOUT=8
MAX_CONCURRENT_SIMULATIONS=2
